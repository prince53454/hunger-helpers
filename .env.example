# PORT: The port the Express application server listens on (default: 3000)
PORT=3000

# NODE_ENV: Application environment ('development' | 'production')
NODE_ENV=development

# APP_URL: The public URL where this applet is hosted.
# Injected at runtime by Google AI Studio.
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Optional secret placeholder.
GEMINI_API_KEY=""

# JWT_SECRET: Secret for signing admin session JWTs (change in production!)
JWT_SECRET="replace-with-a-long-random-secret"
